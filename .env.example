# Django Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=healthcare_db
